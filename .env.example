# ── Scan settings ─────────────────────────────────────────────────────────────
SCAN_LIMIT=0      # Max messages to fetch per run. 0 = whole inbox (progress is saved, so it resumes).
BATCH_SIZE=1000   # Gmail batchDelete chunk size (max 1000).

# ── Output files ──────────────────────────────────────────────────────────────
LOG_FILE=cleanup-log.json

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=            # Set to 1 for verbose error stack traces.
